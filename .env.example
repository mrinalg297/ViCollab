# Copy to .env and change if needed. The app still runs without Ollama: AI features show "AI unavailable".
OLLAMA_URL=http://localhost:11434
AI_MODEL=qwen3:8b
# Optional: how long to wait for one model reply, in milliseconds (default 120000)
# AI_TIMEOUT_MS=120000
# Optional: how long Ollama keeps the model loaded after a request (default 30m)
# AI_KEEP_ALIVE=30m
